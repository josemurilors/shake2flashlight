# chop-lanterna.desktop — copy to ~/.local/share/applications/ (all users:
# /usr/share/applications/) and copy the hicolor/ tree next to your theme
# icons (~/.local/share/icons/ or /usr/share/icons/). Adjust Exec to the
# real command that starts the application.
[Desktop Entry]
Type=Application
Version=1.0
Name=Chop Lanterna
Exec=chop-lanterna
Icon=chop-lanterna
Terminal=false
Categories=Utility;
